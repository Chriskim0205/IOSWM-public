# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋하지 않습니다)

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Jira
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_USER=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=버그
JIRA_LABEL=WEMIXWALLET
JIRA_ASSIGNEE_ID=
JIRA_BOARD_URL=https://your-domain.atlassian.net/jira/software/projects/KEY/boards/1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets
GSPREAD_KEY_FILE=secrets/service-account.json
CHECKLIST_SHEET_URL=
CHECKLIST_WORKSHEET=Checklist

# Appium / iOS 실기기
APPIUM_SERVER_URL=http://127.0.0.1:4723/wd/hub
IOS_APP_BUNDLE_ID=com.wemixfoundation.wemixwallet
IOS_DEVICE_NAME=
IOS_PLATFORM_VERSION=17.3
IOS_UDID=
XCODE_ORG_ID=
XCODE_SIGNING_ID=iPhone Developer

# 테스트 전용 지갑 (실자산이 없는 지갑만 사용)
WALLET_MNEMONIC=
WALLET_MAIN_PRIVATE_KEY=
WALLET_SECOND_PRIVATE_KEY=
WALLET_ADDRESS=
